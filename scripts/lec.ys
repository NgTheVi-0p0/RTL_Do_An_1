# =====================================================================
# SỬ DỤNG PHƯƠNG PHÁP KIỂM TRA TỔ HỢP (CEC) - CHẠY SIÊU NHANH
# =====================================================================

# ----------------- 1. ĐỌC RTL (GOLD) -----------------
read_liberty -ignore_miss_func sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog -sv src/*.v

# Khôi phục các blackbox để cô lập hoàn toàn dung lượng bộ nhớ lớn
blackbox instruction_memory
blackbox data_memory
blackbox Register_File

hierarchy -check -top __TOP__
prep -top __TOP__
flatten
memory
opt
design -stash gold

# ----------------- 2. ĐỌC NETLIST ĐÃ CÓ SẴN (GATE) -----------------
read_liberty -ignore_miss_func sky130_fd_sc_hd__tt_025C_1v80.lib

read_verilog -sv __NETLIST__

# Khôi phục các blackbox ở bản Gate
blackbox instruction_memory
blackbox data_memory
blackbox Register_File

hierarchy -check -top __TOP__
prep -top __TOP__
flatten
memory
opt
design -stash gate

# ----------------- 3. CHẠY LEC TỔ HỢP (CHỈ MẤT VÀI PHÚT) -----------------

design -copy-from gold -as gold __TOP__
design -copy-from gate -as gate __TOP__

equiv_make gold gate equiv
hierarchy -top equiv
flatten

async2sync

setundef -undriven -zero
setundef -zero

# So khớp cấu trúc và giải SAT tổ hợp (Bỏ hoàn toàn lệnh equiv_induct)
equiv_struct
equiv_simple

# Kiểm tra trạng thái chứng minh tương đương
equiv_status